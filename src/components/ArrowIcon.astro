---
interface Props {
  direction?: 'up-right' | 'left' | 'right' | 'up';
  class?: string;
}
const { direction = 'up-right', class: className } = Astro.props;
const paths = {
  'up-right': 'M5 19 19 5M7 5h12v12',
  left: 'M20 12H4m6-6-6 6 6 6',
  right: 'M4 12h16m-6-6 6 6-6 6',
  up: 'M12 20V4m-6 6 6-6 6 6',
};
---

<!-- Un tracé vectoriel évite la substitution des caractères par des emoji iOS. -->
<svg
  class={className}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[direction]} />
</svg>
