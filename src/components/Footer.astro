---
import ArrowIcon from './ArrowIcon.astro';
---

<footer class="shell section-space closing">
  <a class="back-to-top" href="#accueil">
    Retour en haut <ArrowIcon direction="up" />
  </a>
</footer>

<script>
  document
    .querySelector<HTMLAnchorElement>('.back-to-top')
    ?.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      event.preventDefault();
      // Une position absolue évite les décalages des ancres et du header sticky.
      window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
      history.replaceState(history.state, '', '#accueil');
    });
</script>
